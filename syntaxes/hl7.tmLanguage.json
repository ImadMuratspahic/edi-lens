{
  "name": "HL7 v2",
  "scopeName": "source.hl7",
  "patterns": [
    { "include": "#msh-segment" },
    { "include": "#segment" }
  ],
  "repository": {
    "msh-segment": {
      "comment": "MSH defines the field separator and the encoding characters.",
      "begin": "^(MSH)(\\|)(\\^~\\\\&)",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.segment.hl7" },
        "2": { "name": "punctuation.separator.field.hl7" },
        "3": { "name": "keyword.other.encoding-characters.hl7" }
      },
      "end": "$",
      "patterns": [
        { "include": "#segment-body" }
      ]
    },
    "segment": {
      "comment": "One segment per line (a segment ends with a carriage return). Highlighting assumes the default separators.",
      "begin": "^([A-Z][A-Z0-9]{2})(?=\\|)",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.segment.hl7" }
      },
      "end": "$",
      "patterns": [
        { "include": "#segment-body" }
      ]
    },
    "segment-body": {
      "patterns": [
        { "include": "#escape" },
        { "include": "#field-separator" },
        { "include": "#repetition-separator" },
        { "include": "#component-separator" },
        { "include": "#subcomponent-separator" },
        { "include": "#timestamp" },
        { "include": "#number" }
      ]
    },
    "escape": {
      "comment": "Escape sequences such as \\F\\, \\S\\, \\T\\, \\R\\, \\E\\, \\X0A\\ and \\.br\\.",
      "match": "\\\\[A-Za-z.][A-Za-z0-9.]{0,10}\\\\",
      "name": "constant.character.escape.hl7"
    },
    "field-separator": {
      "match": "\\|",
      "name": "punctuation.separator.field.hl7"
    },
    "repetition-separator": {
      "match": "~",
      "name": "punctuation.separator.repetition.hl7"
    },
    "component-separator": {
      "match": "\\^",
      "name": "punctuation.separator.component.hl7"
    },
    "subcomponent-separator": {
      "match": "&",
      "name": "punctuation.separator.subcomponent.hl7"
    },
    "timestamp": {
      "comment": "Date and time values: YYYYMMDD with optional time, fraction and zone offset.",
      "match": "(?<![0-9A-Za-z.])[0-9]{8}(?:[0-9]{2,12})?(?:\\.[0-9]{1,4})?(?:[+-][0-9]{4})?(?![0-9A-Za-z])",
      "name": "constant.numeric.timestamp.hl7"
    },
    "number": {
      "match": "(?<![A-Za-z0-9])[0-9]+(?:\\.[0-9]+)?(?![A-Za-z0-9])",
      "name": "constant.numeric.hl7"
    }
  }
}
